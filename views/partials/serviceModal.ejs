<!-- views/partials/serviceModal.ejs -->
<div class="modal-overlay" id="serviceModalOverlay">
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <button class="modal-close" id="modalClose" aria-label="Close">&times;</button>

    <h3 id="modalTitle">Please fill these details</h3>
    <p class="modal-sub">Our executive will call you shortly.</p>

    <form id="serviceModalForm" class="modal-form" novalidate>
      <input type="hidden" id="modalService" name="service" />

      <div class="form-group">
        <label for="modalName">Name *</label>
        <input type="text" id="modalName" name="name" required />
      </div>

      <div class="form-group">
        <label for="modalPhone">Phone / WhatsApp *</label>
        <input type="tel" id="modalPhone" name="phone" required />
      </div>

      <div class="form-group">
        <label for="modalBusiness">Business Name *</label>
        <input type="text" id="modalBusiness" name="business" required />
      </div>

      <p class="modal-service-tag">
        Interested in: <strong id="modalServiceLabel"></strong>
      </p>

      <div id="modalErrors" class="form-errors" role="alert"></div>
      <div id="modalSuccess" class="form-success" role="status"></div>

      <button type="submit" class="btn btn-primary btn-block" id="modalSubmitBtn">
        Request a Call Back
      </button>
    </form>
  </div>
</div>
